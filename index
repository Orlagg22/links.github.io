<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Orlando | Links</title>

    <meta name="description" content="Todos mis enlaces en un solo lugar.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #050505;
            --card: rgba(20, 20, 20, 0.72);
            --line: rgba(255, 255, 255, 0.10);
            --text: #f5f5f5;
            --muted: #929292;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Inter", sans-serif;
            color: var(--text);

            background:
                radial-gradient(
                    circle at 50% 8%,
                    rgba(255, 255, 255, 0.09),
                    transparent 28%
                ),
                radial-gradient(
                    circle at 10% 90%,
                    rgba(255, 255, 255, 0.035),
                    transparent 30%
                ),
                #050505;

            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            opacity: 0.18;

            background-image:
                url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E");

            mix-blend-mode: screen;
        }

        .wrap {
            width: min(680px, calc(100% - 30px));
            margin: 0 auto;
            padding: 54px 0 30px;
            position: relative;
        }

        .profile {
            text-align: center;
            animation: fadeUp 0.8s ease both;
        }

        .avatar {
            width: 104px;
            height: 104px;
            border-radius: 50%;
            margin: 0 auto 18px;

            display: grid;
            place-items: center;

            border: 1px solid rgba(255, 255, 255, 0.22);

            background: linear-gradient(
                145deg,
                #242424,
                #090909
            );

            box-shadow:
                0 18px 60px rgba(0, 0, 0, 0.65),
                inset 0 0 0 7px rgba(255, 255, 255, 0.025);

            font-family: "Playfair Display", serif;
            font-size: 37px;
            letter-spacing: -2px;
        }

        h1 {
            font-family: "Playfair Display", serif;
            font-size: 30px;
            margin: 0 0 8px;
            letter-spacing: 0.3px;
        }

        .bio {
            max-width: 460px;
            margin: 15px auto 0;
            color: #b8b8b8;
            line-height: 1.65;
            font-size: 14px;
        }

        .socials {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin: 22px 0 32px;
        }

        .social {
            width: 42px;
            height: 42px;

            border: 1px solid var(--line);
            border-radius: 50%;

            display: grid;
            place-items: center;

            color: #eeeeee;
            text-decoration: none;

            background: rgba(255, 255, 255, 0.035);

            transition: 0.25s;
        }

        .social:hover {
            transform: translateY(-3px);
            background: #ffffff;
            color: #000000;
            border-color: #ffffff;
        }

        .icon {
            width: 18px;
            height: 18px;
            fill: currentColor;
        }

        .section {
            font-size: 10px;
            color: #666666;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            margin: 28px 3px 12px;
        }

        .links {
            display: grid;
            gap: 13px;
        }

        .link {
            position: relative;

            display: flex;
            align-items: center;

            min-height: 67px;
            padding: 11px 17px;

            border: 1px solid var(--line);
            border-radius: 17px;

            color: #ffffff;
            text-decoration: none;

            background: linear-gradient(
                110deg,
                rgba(255, 255, 255, 0.075),
                rgba(255, 255, 255, 0.025)
            );

            backdrop-filter: blur(14px);

            overflow: hidden;
            transition: 0.28s;

            animation: fadeUp 0.7s ease both;
        }

        .link:nth-child(2) {
            animation-delay: 0.06s;
        }

        .link:nth-child(3) {
            animation-delay: 0.12s;
        }

        .link:nth-child(4) {
            animation-delay: 0.18s;
        }

        .link::after {
            content: "";
            position: absolute;
            inset: 0;

            transform: translateX(-110%);

            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.08),
                transparent
            );

            transition: 0.55s;
        }

        .link:hover {
            transform: translateY(-3px);

            border-color: rgba(255, 255, 255, 0.28);

            box-shadow:
                0 14px 35px rgba(0, 0, 0, 0.35);
        }

        .link:hover::after {
            transform: translateX(110%);
        }

        .link-icon {
            width: 44px;
            height: 44px;

            border-radius: 12px;

            display: grid;
            place-items: center;

            background: #111111;

            border: 1px solid rgba(255, 255, 255, 0.08);

            margin-right: 13px;
            flex: none;
        }

        .link-icon b {
            font-size: 20px;
            font-weight: 400;
        }

        .copy {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 0;
        }

        .title {
            font-size: 14px;
            font-weight: 600;
        }

        .desc {
            font-size: 11px;
            color: #8f8f8f;

            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .arrow {
            margin-left: auto;
            color: #777777;
            font-size: 20px;
            transition: 0.25s;
        }

        .link:hover .arrow {
            color: #ffffff;
            transform: translateX(3px);
        }

        footer {
            text-align: center;
            color: #555555;
            font-size: 10px;
            letter-spacing: 1.4px;
            margin-top: 35px;
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 480px) {
            .wrap {
                padding-top: 40px;
            }

            .avatar {
                width: 92px;
                height: 92px;
                font-size: 33px;
            }

            h1 {
                font-size: 27px;
            }

            .bio {
                font-size: 13px;
            }

            .link {
                min-height: 63px;
            }
        }
    </style>
</head>

<body>

    <main class="wrap">

        <section class="profile">

            <div class="avatar">O</div>

            <h1>Orlando</h1>

            <p class="bio">
                Tecnología · Gaming · Creatividad
                <br>
                Un pequeño rincón donde puedes encontrarme.
            </p>

            <div class="socials">

                <!-- INSTAGRAM -->
                <a
                    class="social"
                    href="https://www.instagram.com/gro_rlrg"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Instagram"
                >
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5Zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5ZM17.5 6a1 1 0 1 1-1 1 1 1 0 0 1 1-1Z"/>
