                <!-- DISCORD -->
                <a
                    class="social"
                    href="https://discord.com/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Discord"
                >
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M19.54 5.35A16.1 16.1 0 0 0 15.7 4l-.47.96a14.6 14.6 0 0 0-6.46 0L8.3 4a16.1 16.1 0 0 0-3.84 1.35C2.03 8.42 1.37 11.4 1.7 14.34a15.8 15.8 0 0 0 4.72 2.38l1.14-1.56c-.63-.24-1.24-.55-1.82-.91l.45-.34c3.5 1.63 7.96 1.63 11.42 0l.45.34c-.58.36-1.19.67-1.82.91l1.14 1.56a15.8 15.8 0 0 0 4.72-2.38c.38-3.41-.65-6.36-2.56-8.99ZM8.96 13.03c-1.03 0-1.88-.95-1.88-2.12s.82-2.12 1.88-2.12c1.05 0 1.88.95 1.88 2.12-.02 1.17-.83 2.12-1.88 2.12Zm6.08 0c-1.03 0-1.88-.95-1.88-2.12s.82-2.12 1.88-2.12c1.05 0 1.88.95 1.88 2.12-.02 1.17-.83 2.12-1.88 2.12Z"/>
                    </svg>
                </a>

                <!-- GITHUB -->
                <a
                    class="social"
                    href="https://github.com/Orlagg22"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="GitHub"
                >
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M12 .7a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.82 2.81 1.29 3.5.99.11-.77.42-1.29.76-1.59-2.67-.3-5.48-1.34-5.48-5.95 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.58A12 12 0 0 0 12 .7Z"/>
                    </svg>
                </a>

            </div>
        </section>

        <div class="section">
            Mis espacios
        </div>

        <section class="links">

            <!-- INSTAGRAM -->
            <a
                class="link"
                href="https://www.instagram.com/gro_rlrg"
                target="_blank"
                rel="noopener noreferrer"
            >
                <span class="link-icon">
                    <b>◎</b>
                </span>

                <span class="copy">
                    <span class="title">Instagram</span>
                    <span class="desc">@gro_rlrg</span>
                </span>

                <span class="arrow">›</span>
            </a>

            <!-- DISCORD -->
            <a
                class="link"
                href="https://discord.com/"
                target="_blank"
                rel="noopener noreferrer"
            >
                <span class="link-icon">
                    <b>◈</b>
                </span>

                <span class="copy">
                    <span class="title">Discord</span>
                    <span class="desc">Orlagg22</span>
                </span>

                <span class="arrow">›</span>
            </a>

            <!-- GITHUB -->
            <a
                class="link"
                href="https://github.com/Orlagg22"
                target="_blank"
                rel="noopener noreferrer"
            >
                <span class="link-icon">
                    <b>⌘</b>
                </span>

                <span class="copy">
                    <span class="title">GitHub</span>
                    <span class="desc">@Orlagg22</span>
                </span>

                <span class="arrow">›</span>
            </a>

            <!-- PRÓXIMAMENTE -->
            <a
                class="link"
                href="#"
                onclick="return false;"
            >
                <span class="link-icon">
                    <b>✦</b>
                </span>

                <span class="copy">
                    <span class="title">Próximamente</span>
                    <span class="desc">Nuevo proyecto en camino</span>
                </span>

                <span class="arrow">›</span>
            </a>

        </section>

        <footer>
            © 2026 · ORLANDO
        </footer>

    </main>

</body>
</html>
